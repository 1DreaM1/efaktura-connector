{
    "name": "dream1/efaktura-connector",
    "description": "Framework-independent Peppol and SAPI e-invoice connector with an optional Laravel bridge.",
    "keywords": ["e-invoicing", "peppol", "sapi", "ubl", "xml"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/1DreaM1/efaktura-connector",
    "authors": [
        {
            "name": "DreaM1",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/1DreaM1/efaktura-connector/issues",
        "source": "https://github.com/1DreaM1/efaktura-connector"
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "infection/infection": "^0.26.6",
        "squizlabs/php_codesniffer": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "erickskrauch/php-cs-fixer-custom-fixers": "^1.3",
        "vlucas/phpdotenv": "^5.4",
        "laravel/framework": "^8.83",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "illuminate/support": "^5.6 || ^8.83 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "DreaM1\\EfakturaConnector\\": "src/",
            "DreaM1\\EfakturaConnector\\Laravel\\": "integrations/laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DreaM1\\EfakturaConnector\\Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 900,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "platform": {
            "php": "7.4.7"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DreaM1\\EfakturaConnector\\Laravel\\EFakturaConnectorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --configuration=phpunit.xml.dist",
        "test:mutation": "infection --configuration=infection.json5",
        "check-style": "phpcs --standard=phpcs.xml.dist",
        "format": "php-cs-fixer fix",
        "check-format": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G"
    }
}
