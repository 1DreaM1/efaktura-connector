{
    "name": "dream1/efaktura-connector-laravel-56-bridge-test",
    "description": "Isolated Composer project for Laravel 5.6 bridge compatibility tests on PHP 7.4.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "laravel/framework": "5.6.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "DreaM1\\EfakturaConnector\\": "../../../src/",
            "DreaM1\\EfakturaConnector\\Laravel\\": "../../../integrations/laravel/src/",
            "DreaM1\\EfakturaConnector\\Tests\\": "../../../tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        },
        "platform": {
            "php": "7.4.0"
        },
        "sort-packages": true
    }
}
